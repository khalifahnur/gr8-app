{
  "expo": {
    "name": "gr8-app",
    "slug": "gr8-app",
   "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gr8.png",
    "scheme": "gr8africagroupapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.lifkha.Gr8AfricaGroup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/gr8.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lifkha.Gr8AfricaGroup"
    },
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#019B41",
          "image": "./assets/gr8.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}